ENVIRONMENT=development
PORT=8010
DATABASE_URL=sqlite:///./backend/presales.db
# Demo escape hatch: allows SQLite on Vercel/production (ephemeral: data lost on cold restart)
ALLOW_EPHEMERAL_DB=false
ADMIN_USERNAME=admin

ADMIN_PASSWORD=CHANGE_ME_UNIQUE_PASSWORD
ADMIN_PASSWORD_HASH=
CORS_ORIGINS=http://localhost:8010,http://127.0.0.1:8010

# Gemini Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_GEMINI_KEY
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_THINKING_LEVEL=low

# Embeddings Configuration
EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Rate & Token Budgets
MESSAGE_RATE_LIMIT=20
MESSAGE_RATE_WINDOW_SECONDS=60
LLM_CALLS_PER_SESSION=30
LLM_CALLS_PER_IP_PER_HOUR=80

# Public Deployment URL & Webhooks
PUBLIC_BASE_URL=https://nexus-presales-bot-sales.vercel.app
SLACK_WEBHOOK_URL=

# Google Calendar Integration (OAuth 2.0)
# TODO (need to ask): Whitelist the redirect URI in Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client IDs > Authorized redirect URIs):
# https://nexus-presales-bot-sales.vercel.app/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nexus-presales-bot-sales.vercel.app/admin/google/callback
GOOGLE_REFRESH_TOKEN=

