LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=
DATABASE_URL=sqlite:///./backend/presales.db
ADMIN_PASSWORD=northline-admin
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./backend/uploads
GCS_BUCKET=
GCS_PREFIX=rfp/
PORT=8000
CONFIG_DIR=./config
# Long-form retrieval library owned by the sales team
CONTENT_DIR=./content
ENVIRONMENT=development
RAG_ENABLED=true
# auto uses pgvector on Postgres and falls back to in-process search on SQLite
RAG_BACKEND=auto
# Blank picks the provider default (OpenAI text-embedding-3-small, Gemini text-embedding-004)
EMBEDDING_MODEL=
LEARNING_ENABLED=true
