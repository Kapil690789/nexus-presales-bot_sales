LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=
DATABASE_URL=sqlite:///./backend/presales.db
ADMIN_USERNAME=admin
# Set a strong password. There is no default. Leave blank to keep /admin locked.
ADMIN_PASSWORD=
# Optional bcrypt hash. If set, ADMIN_PASSWORD is ignored.
# python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./backend/uploads
GCS_BUCKET=
GCS_PREFIX=rfp/
PORT=8000
CONFIG_DIR=./config
# Long-form retrieval library owned by the sales team
CONTENT_DIR=./content
ENVIRONMENT=development
RAG_ENABLED=true
# auto uses pgvector on Postgres and falls back to in-process search on SQLite
RAG_BACKEND=auto
# Blank picks the provider default (OpenAI text-embedding-3-small, Gemini text-embedding-004)
EMBEDDING_MODEL=
LEARNING_ENABLED=true
# Google Calendar — owner OAuth. Visitors do not sign in with Google.
# Also accepted from the repo-root .env as Google_Client_ID / Google_Client_Secret.
GOOGLE_REDIRECT_URI=http://localhost:8000/admin/google/callback
GOOGLE_CALENDAR_ID=primary
# Optional: paste a refresh token instead of using /admin/calendar
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack Incoming Webhook — posts when a visitor books a call. Leave blank to stub.
SLACK_WEBHOOK_URL=
# Public origin for admin links in Slack (e.g. https://bot.example.com). Optional.
PUBLIC_BASE_URL=